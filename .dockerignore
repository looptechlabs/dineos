# Node dependencies (will be installed fresh in container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output (will be generated during build)
.next/
out/

# Environment files (NEVER include these!)
.env
.env*.local
.env.local
.env.development
.env.production

# IDE files
.vscode/
.idea/
*.swp
.DS_Store

# Git
.git/
.gitignore

# Docker files (no need to copy into image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation (optional)
README.md
*.md

# Testing
coverage/
.nyc_output/

# Logs
logs/
*.log